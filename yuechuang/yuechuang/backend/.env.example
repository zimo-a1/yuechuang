# Phase 3 Demo controls. Add these lines to your existing .env; do not replace keys.
# -1 = disabled (default); 0 = block new dispatches/regenerations.
YC_DAILY_VIDEO_SECONDS=-1
YC_MAX_VIDEO_REGENERATIONS_PER_EPISODE=-1

# Optional: otherwise search PATH and ~/.local/bin/ffmpeg.
# YC_FFMPEG_PATH=/absolute/path/to/ffmpeg

# Optional Tudou Veo smoke test; never paste a real key in this example file.
TUDOU_API_KEY=

# Grok image inputs require public HTTPS URLs. Optional mapping file, no automatic upload.
# JSON keys: absolute local image paths; values: existing public/signed HTTPS URLs.
# Keep the file in ignored temp/; never commit signed URLs or expose a local server.
# TUDOU_REFERENCE_URL_MAP_FILE=/absolute/path/to/backend/temp/tudou-reference-urls.json

# Optional novel text workflow limits; at most 2 output repairs per step, SDK retries disabled.
# YC_NOVEL_REPAIR_ATTEMPTS=2
# YC_NOVEL_TIMEOUT=180
# YC_NOVEL_MAX_TOKENS=12000
# YC_NOVEL_CHUNK_CHARS=6000
# YC_NOVEL_CONTEXT_CHARS=100000

# ToAPIs image/video services (https://toapis.cn)
TOAPIS_API_KEY=
